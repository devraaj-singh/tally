# Postgres connection string (Neon in production; PGlite locally if unset)
DATABASE_URL=
# Password for the single-user gate
APP_PASSWORD=
# Random secret used to sign the session cookie (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# Local dev only: set to 1 to force the password gate ON while using the PGlite
# demo DB (so you can test the /login screen). Leave unset for normal demo mode.
TALLY_FORCE_AUTH=
